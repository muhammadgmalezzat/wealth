# EAS uses this file INSTEAD of .gitignore when uploading a build.

# PRIVATE real data — never uploaded (changed 2026-11-25). store/seed.local.ts is loaded only in development
# (`if (__DEV__)` in store/useFinanceStore.ts), so no production build can use it; uploading it would only expose it.
# Production builds and OTAs start from the synthetic store/seed.example.ts. `npm run check:release` verifies the
# bundles. Real backups (.local/, wealth-backup-*.json) are excluded for the same reason.
store/seed.local.ts
.local/
wealth-backup-*.json
*.backup.json

# dependencies (installed on the build server)
node_modules/

# Expo / build output
.expo/
dist/
web-build/
expo-env.d.ts
*.tsbuildinfo
coverage/
app-example

# generated native folders (EAS runs prebuild from app.json)
/ios
/android
.kotlin/

# version control, editors and assistants
.git/
.claude/
.qodo/
.vscode/
.idea/

# secrets and signing material
.env
.env.*
*.keystore
*.jks
*.p8
*.p12
*.key
*.pem
*.mobileprovision

# logs and OS junk
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
.metro-health-check*
*.orig.*
.DS_Store
Thumbs.db
